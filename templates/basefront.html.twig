{% extends "base.html.twig" %}

{% block top %}
<div class="container">
    <div class="text-left">
        <img src="{{ app.request.getBasePath() ~ '/banniere.jpg' }}" alt="Bannière">
    </div>
    
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav mr-auto">
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('accueil') }}">Accueil</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('formations') }}">Formations</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('playlists') }}">Playlists</a>
                </li>

                {% if is_granted('ROLE_ADMIN') %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('admin.categories') }}">Gestion Catégories</a>
                    </li>
                {% endif %}
            </ul>

            <ul class="navbar-nav ms-auto">
                {% if app.user %}
                    <li class="nav-item">
                        <span class="nav-link text-muted"> {{ app.user.username }}</span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link btn btn-outline-danger btn-sm ms-2" href="{{ path('app_logout') }}">Déconnexion</a>
                    </li>
                {% else %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_login') }}">Connexion</a>
                    </li>
                {% endif %}
            </ul>
        </div>
    </nav>
</div>
{% endblock %}

{% block body %}{% endblock %}

{% block footer %}
<div class="container text-center mt-5 mb-4">
    <hr class="border-light opacity-50">
    <p class="text-muted small">
        <i>Consultez nos <a href="{{ path('cgu') }}" class="text-decoration-none fw-bold" style="color: #4ebbe4;">CGU</a></i>
    </p>
</div>
{% endblock %}
{% extends "base.html.twig" %}

{% block top %}
<div class="container py-2"> 
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="text-left">
           
            <img src="{{ app.request.getBasePath() ~ '/banniere.jpg' }}" 
                 alt="Bannière" 
                 class="img-fluid" 
                 style="max-height: 100px; width: auto; object-fit: contain;">
        </div>
        
        {% if is_granted('ROLE_ADMIN') %}
            <div class="text-right">
                
                <span class="h5 text-info fw-bold d-none d-sm-inline">Backoffice</span>
                <span class="badge bg-info d-inline d-sm-none">Admin</span>
            </div>
        {% endif %}
    </div>
    
    <nav class="navbar navbar-expand-lg navbar-light bg-light shadow-sm rounded">
        <div class="container-fluid"> 
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon" style="font-size: 0.8rem;"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0"> 
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('accueil') }}">Accueil</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('formations') }}">Formations</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('playlists') }}">Playlists</a>
                    </li>

                    {% if is_granted('ROLE_ADMIN') %}
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('admin.categories') }}">Catégories</a>
                        </li>
                    {% endif %}
                </ul>

                <ul class="navbar-nav ms-auto">
                    {% if app.user %}
                        <li class="nav-item d-flex align-items-center">
                            <span class="nav-link text-muted small"> {{ app.user.username }}</span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link btn btn-outline-danger btn-sm ms-lg-2" href="{{ path('app_logout') }}">Déconnexion</a>
                        </li>
                    {% else %}
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_login') }}">Connexion</a>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </nav>

    
    <div class="mt-2">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show py-2 small" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" style="padding: 0.5rem;"></button>
            </div>
        {% endfor %}
        
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger alert-dismissible fade show py-2 small" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" style="padding: 0.5rem;"></button>
            </div>
        {% endfor %}
    </div>
</div>


<style>
    @media (max-width: 576px) {
        h2, .h2 { font-size: 1.25rem !important; margin-top: 10px !important; }
        p { font-size: 0.9rem !important; }
        .container { padding-left: 10px !important; padding-right: 10px !important; }
       
        img[alt="Bannière"] { max-height: 60px !important; }
    }
</style>
{% endblock %}

{% block body %}{% endblock %}

{% block footer %}
<div class="container text-center mt-4 mb-3">
    <hr class="border-light opacity-50">
    <p class="text-muted small">
        <i>Consultez nos <a href="{{ path('cgu') }}" class="text-decoration-none fw-bold" style="color: #4ebbe4;">CGU</a></i>
    </p>
</div>
{% endblock %}
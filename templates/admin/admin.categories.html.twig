{% extends "basefront.html.twig" %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3">
        <h2 class="text-secondary fw-light m-0">Gestion des catégories</h2>
        
        
        <form method="POST" action="{{ path('admin.categories') }}" class="d-flex align-items-center">
            <input type="text" name="nom" class="form-control form-control-sm bg-white border shadow-none me-2" 
                   placeholder="Nom de la catégorie" required style="width: 250px;">
            <button type="submit" class="btn btn-outline-success border-2 fw-bold px-4">
                <i class="fa fa-plus"></i> AJOUTER
            </button>
        </form>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'error' ? 'danger' : 'success' }} alert-dismissible fade show border-0 shadow-sm mb-3">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white">
            <thead class="bg-light">
                <tr class="text-uppercase small text-muted border-bottom" style="font-size: 0.75rem; letter-spacing: 1px;">
                    <th class="py-3 border-0 px-3">Nom de la catégorie</th>
                    <th class="py-3 border-0 text-end px-4" style="width: 200px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for categorie in categories %}
                    <tr class="border-light">
                        <td class="py-3 px-3">
                            <span class="fw-bold" style="color: #4ebbe4;">{{ categorie.name }}</span>
                        </td>
                        <td class="text-end px-4">
                            <a href="{{ path('admin.categorie.suppr', {id:categorie.id}) }}" 
                               class="text-danger text-decoration-none small"
                               onclick="return confirm('Supprimer la catégorie {{ categorie.name|escape('js') }} ?')">
                                Supprimer
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="2" class="text-center text-muted py-4">Aucune catégorie disponible.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<style>
    
    .table thead th { 
        background-color: #f8f9fa; 
        vertical-align: middle;
    }
    .form-control-sm:focus { 
        border-color: #4ebbe4; 
        box-shadow: none; 
    }
    .btn-outline-success:hover {
        background-color: #438f63;
        border-color: #438f63;
    }
</style>
{% endblock %}
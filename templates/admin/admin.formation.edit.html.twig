{% extends "basefront.html.twig" %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-secondary fw-bold">
            {% if formation.id is defined and formation.id is not null %}
                Modifier la formation
            {% else %}
                Ajouter une formation
            {% endif %}
        </h2>
        <a href="{{ path('formations') }}" class="btn btn-warning text-white fw-bold shadow-sm">
            <i class="fa fa-arrow-left"></i> Retour aux formations
        </a>
    </div>

    <div class="p-4 shadow-sm" style="background-color: #ededed; border-radius: 10px;">
        {% if form is defined %}
            {{ form_start(form) }}
            
            {# Ligne 1 : Date, Title, Video ID #}
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label text-muted small fw-bold">Date</label>
                    {{ form_widget(form.publishedAt, {'attr': {'class': 'form-control bg-white border-0', 'style': 'padding: 0.6rem;'}}) }}
                </div>
                <div class="col-md-4">
                    <label class="form-label text-muted small fw-bold">Title</label>
                    {{ form_widget(form.title, {'attr': {'class': 'form-control bg-white border-0', 'placeholder': 'Titre', 'style': 'padding: 0.6rem;'}}) }}
                </div>
                <div class="col-md-4">
                    <label class="form-label text-muted small fw-bold">Video id</label>
                    {{ form_widget(form.videoId, {'attr': {'class': 'form-control bg-white border-0', 'placeholder': 'ID de la vidéo', 'style': 'padding: 0.6rem;'}}) }}
                </div>
            </div>

            {# Ligne 2 : Description #}
            <div class="mt-4">
                <label class="form-label text-muted small fw-bold">Description</label>
                {{ form_widget(form.description, {'attr': {'class': 'form-control bg-white border-0', 'placeholder': 'Description', 'rows': '4'}}) }}
            </div>

            {# Ligne 3 : Playlist #}
            <div class="mt-4">
                <label class="form-label text-muted small fw-bold">Playlist</label>
                {{ form_widget(form.playlist, {'attr': {'class': 'form-select bg-white border-0'}}) }}
            </div>

            {# Ligne 4 : Catégories #}
            <div class="mt-4">
                <label class="form-label text-muted small fw-bold">Categories</label>
                {{ form_widget(form.categories, {'attr': {'class': 'form-control bg-white border-0', 'style': 'height: 150px;'}}) }}
            </div>

            {# Bouton de validation #}
            <div class="mt-4">
                <button type="submit" class="btn btn-success px-5 py-2 fw-bold shadow-sm" style="border-radius: 5px;">
                    Valider
                </button>
            </div>

            {{ form_end(form) }}
        {% else %}
            <div class="alert alert-danger">Erreur : Le formulaire n'a pas pu être chargé.</div>
        {% endif %}
    </div>
</div>
{% endblock %}
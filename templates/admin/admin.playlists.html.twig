{% extends "basefront.html.twig" %}

{% block body %}
<div class="container mt-4">
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <div class="row mb-4 align-items-center">
        <div class="col">
            <h2 class="text-secondary fw-bold">Gestion des playlists</h2>
        </div>
        
        {% if is_granted('ROLE_ADMIN') %}
            <div class="col text-end">
                <a href="{{ path('admin.playlist.ajout') }}" class="btn btn-success shadow-sm">
                    <i class="fa fa-plus"></i> Ajouter une playlist
                </a>
            </div>
        {% endif %}
    </div>

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr class="text-muted small">
                    <th scope="col" class="border-0">PLAYLIST</th>
                    <th scope="col" class="border-0">NOMBRE DE FORMATIONS</th>
                    
                   
                    {% if is_granted('ROLE_ADMIN') %}
                        <th scope="col" class="text-center border-0" style="width: 200px;">ACTIONS</th>
                    {% endif %}
                </tr>
            </thead>
            <tbody>
                {% for playlist in playlists %}
                <tr>
                    <td class="fw-bold text-info">
                        {# Lien vers le détail de la playlist pour tout le monde #}
                        <a href="{{ path('playlists.showone', {id:playlist.id}) }}" class="text-decoration-none text-info">
                            {{ playlist.name }}
                        </a>
                    </td>
                    <td>
                        <span class="badge bg-light text-secondary border">
                            {{ playlist.formations|length }} formation(s)
                        </span>
                    </td>
                    
                  
                    {% if is_granted('ROLE_ADMIN') %}
                        <td class="text-center">
                            <a href="{{ path('admin.playlist.edit', {id:playlist.id}) }}" 
                               class="btn btn-outline-secondary btn-sm border-0">
                                <i class="fa fa-edit"></i> Modifier
                            </a>
                            <a href="{{ path('admin.playlist.suppr', {id:playlist.id}) }}" 
                               class="btn btn-outline-danger btn-sm border-0" 
                               onclick="return confirm('Supprimer la playlist {{ playlist.name }} ?')">
                                <i class="fa fa-trash"></i> Supprimer
                            </a>
                        </td>
                    {% endif %}
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
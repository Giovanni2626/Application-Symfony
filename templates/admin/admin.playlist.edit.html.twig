{% extends "basefront.html.twig" %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-secondary fw-bold">
            {% if playlist.id %}Modifier{% else %}Ajouter{% endif %} la playlist
        </h2>
        {# Vérifie que le nom de la route 'playlists' est correct dans ton contrôleur #}
        <a href="{{ path('playlists') }}" class="btn btn-warning text-white fw-bold shadow-sm">
            <i class="fa fa-arrow-left"></i> Retour aux playlists
        </a>
    </div>

    <div class="p-4 shadow-sm" style="background-color: #ededed; border-radius: 10px;">
        {{ form_start(form) }}
            
            <div class="mb-4">
                <label class="form-label text-muted small fw-bold">NOM DE LA PLAYLIST</label>
                {# Utilisation de form_widget pour styliser précisément #}
                {{ form_widget(form.name, {'attr': {'class': 'form-control border-0 bg-white', 'style': 'padding: 0.75rem;'}}) }}
                {{ form_errors(form.name) }}
            </div>

            <div class="mb-4">
                <label class="form-label text-muted small fw-bold">DESCRIPTION</label>
                {{ form_widget(form.description, {'attr': {'class': 'form-control border-0 bg-white', 'rows': '5'}}) }}
                {{ form_errors(form.description) }}
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-success px-5 py-2 fw-bold shadow-sm">
                    VALIDER
                </button>
            </div>
        {{ form_end(form) }}
    </div>

    {% if playlist.id %}
        <div class="mt-5 mb-5">
            <h3 class="text-secondary mb-3">Formations rattachées</h3>
            <div class="list-group shadow-sm">
                {% for formation in playlist.formations %}
                    <div class="list-group-item d-flex justify-content-between align-items-center border-0 mb-1 rounded bg-white">
                        <span class="fw-bold text-info">{{ formation.title }}</span>
                        <span class="badge bg-light text-muted border">ID: {{ formation.id }}</span>
                    </div>
                {% else %}
                    <div class="list-group-item text-muted bg-light border-0">
                        Aucune formation rattachée.
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
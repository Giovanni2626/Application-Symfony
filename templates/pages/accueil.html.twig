{% extends "basefront.html.twig" %}

{% block body %}
    <p class="mt-3">
        <h3 class="text-secondary fw-light">Bienvenue sur le site de MediaTek86 consacré aux formations en ligne</h3>
    </p>
    <p class="mt-3 text-muted">
        Vous allez pouvoir vous former à différents outils numériques gratuitement et directement en ligne.<br />
        Dans la partie <strong><a href="{{ path('formations') }}" class="text-decoration-none" style="color: #4ebbe4;">Formations</a></strong>, vous trouverez la liste des formations proposées.
        Vous pourrez faire des recherches et des tris. 
        En cliquant sur la capture, vous accèderez à la présentation plus détaillée de la formation ainsi que la vidéo correspondante.<BR />
        Vous pouvez aussi retrouver les vidéos regroupées dans des playlists, dans la partie <strong><a href="{{ path('playlists') }}" class="text-decoration-none" style="color: #4ebbe4;">Playlists</a></strong>.
    </p>
    
    <div class="mt-4">
        <p class="text-secondary">Voici les <strong>deux dernières formations</strong> ajoutées au catalogue :</p>
        
        <div class="row">
            {% for formation in formations %}
                <div class="col-md-6 mb-4">
                    <div class="row align-items-center">
                        <div class="col-sm-5">
                            {# Image avec arrondi léger comme sur tes captures #}
                            {% if formation.picture %}
                                <a href="{{ path('formations.showone', {id:formation.id}) }}">
                                    <img src="{{ formation.picture }}" 
                                         alt="{{ formation.title }}"
                                         class="img-fluid rounded shadow-sm border border-light">
                                </a>    
                            {% endif %}
                        </div>
                        <div class="col-sm-7 text-muted">
                            <p class="small mb-1">{{ formation.publishedatstring }}</p>
                            <h5 class="mt-1 fw-bold" style="color: #4ebbe4; font-size: 1.1rem;">
                                {{ formation.title }}
                            </h5>
                            <div class="small">
                                <strong class="text-secondary">playlist : </strong>{{ formation.playlist.name }}<br />
                                <strong class="text-secondary">catégories : </strong> 
                                {% for categorie in formation.categories %}
                                    <span class="badge rounded-pill bg-light text-secondary border-0" style="font-weight: normal;">
                                        {{ categorie.name }}
                                    </span>&nbsp;
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}